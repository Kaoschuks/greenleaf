{
  "info": {
    "name": "GreenLeaf Insurance API",
    "description": "Complete API collection for GreenLeaf Insurance Broker platform. GreenLeaf acts as an agent on insurance providers (e.g. Sovereign Trust). All policies are created on the provider first; GreenLeaf's database records reference the provider policy.\n\n**Setup:**\n1. Set `base_url` variable (default: `http://localhost:5000`)\n2. Run `POST /auth/login` → copy token → set `user_token`\n3. Run `POST /auth/admin/login` → copy token → set `admin_token`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000", "type": "string" },
    { "key": "user_token", "value": "", "type": "string" },
    { "key": "admin_token", "value": "", "type": "string" },
    { "key": "policy_id", "value": "1", "type": "string" },
    { "key": "provider_id", "value": "1", "type": "string" },
    { "key": "user_id", "value": "1", "type": "string" },
    { "key": "transaction_id", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/signup",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Amara\",\n  \"last_name\": \"Okafor\",\n  \"middle_name\": \"Chidi\",\n  \"email\": \"amara.okafor@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"phone\": \"08012345678\",\n  \"gender\": \"female\",\n  \"date_of_birth\": \"1995-04-12\",\n  \"nin\": \"12345678901\",\n  \"referral_code\": \"\"\n}"
            }
          },
          "response": [
            {
              "name": "Success",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"message\": \"User registered successfully\"\n}"
            }
          ]
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) pm.collectionVariables.set('user_token', res.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"amara.okafor@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            }
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"message\": \"Login successful\",\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\"\n}"
            },
            {
              "name": "Invalid Credentials",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"error\": \"Invalid email or password\"\n}"
            }
          ]
        },
        {
          "name": "Get Current User (Auth)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }]
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"first_name\": \"Amara\",\n  \"last_name\": \"Okafor\",\n  \"email\": \"amara.okafor@example.com\",\n  \"phone\": \"08012345678\",\n  \"gender\": \"female\"\n}"
            }
          ]
        },
        {
          "name": "Get Referral Code",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me/referral",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }]
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"code\": \"AMARA2024\"\n}"
            }
          ]
        },
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.response && res.response.token) pm.collectionVariables.set('admin_token', res.response.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/admin/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"superadmin\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"message\": \"Login successful\",\n  \"response\": {\n    \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n    \"user\": {\n      \"id\": 1,\n      \"first_name\": \"Super\",\n      \"last_name\": \"Admin\",\n      \"username\": \"superadmin\",\n      \"role\": \"superadmin\"\n    }\n  }\n}"
            }
          ]
        },
        {
          "name": "Create Admin",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/admin/create",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Emeka\",\n  \"last_name\": \"Nwosu\",\n  \"username\": \"emeka.admin\",\n  \"password\": \"AdminPass123!\",\n  \"role\": \"admin\"\n}"
            }
          },
          "response": [
            {
              "name": "Success",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"message\": \"Admin User created successfully\"\n}"
            }
          ]
        }
      ]
    },
